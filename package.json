{
  "name": "roboarena",
  "version": "0.0.1",
  "private": true,
  "description": "RoboArena \u2014 a deterministic online robot tactics game built with Next.js and PixiJS.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "next dev",
    "dev:server": "tsx watch server/index.ts",
    "build": "next build",
    "start": "next start",
    "start:server": "tsx server/index.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"worker/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.mjs\" \"*.{json,mjs,ts}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"worker/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.mjs\" \"*.{json,mjs,ts}\" \".github/**/*.yml\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "scenario": "tsx src/scenario/cli.ts",
    "typecheck": "tsc --noEmit --incremental false && tsc -p worker --noEmit --incremental false",
    "dev:rooms": "wrangler dev -c worker/wrangler.jsonc",
    "deploy:rooms": "wrangler deploy -c worker/wrangler.jsonc",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.24.0",
    "next": "^16.3.8",
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.186.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@eslint/js": "^10.0.1",
    "@opennextjs/cloudflare": "^1.20.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.7.0",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.150.0"
  }
}
